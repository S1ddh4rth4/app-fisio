# ============================================
# Variables de entorno requeridas para producción
# ============================================

# PostgreSQL
POSTGRES_PASSWORD=cambiar_por_password_seguro

# JWT (mínimo 32 caracteres, generarlo con: openssl rand -base64 48)
JWT_SECRET=cambiar_por_clave_secreta_generada

# CORS (dominio del frontend en producción)
CORS_ALLOWED_ORIGINS=https://tu-dominio.com