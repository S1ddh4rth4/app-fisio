# ============================================
# Variables de entorno requeridas para producción (VPS)
# Copia este archivo a .env en el servidor: cp .env.example .env
# ============================================

# Oracle Database 21c XE
ORACLE_SYSTEM_PASSWORD=cambiar_por_password_admin_seguro
ORACLE_APP_USER=appfisio
ORACLE_APP_PASSWORD=cambiar_por_password_app_seguro

# JWT (mínimo 32 caracteres, generarlo con: openssl rand -base64 48)
JWT_SECRET=cambiar_por_clave_secreta_jwt_generada

# Cifrado AES de Expedientes Clínicos (exactamente 32 caracteres ASCII)
# IMPORTANTE: No perder ni cambiar esta llave una vez en producción
ENCRYPTION_SECRET=CambiarPorLlaveAESDe32Caracteres

# CORS (dominio real del frontend en producción, sin barra al final)
CORS_ALLOWED_ORIGINS=https://tu-clinica.com